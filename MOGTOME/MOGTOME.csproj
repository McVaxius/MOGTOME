<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Version>3.0.0.5</Version>
    <FileVersion>3.0.0.5</FileVersion>
    <AssemblyVersion>3.0.0.5</AssemblyVersion>
    <PackageProjectUrl>https://github.com/McVaxius/MOGTOME</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <DalamudLibPath Condition="$(DALAMUD_HOME) != ''">$(DALAMUD_HOME)/</DalamudLibPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../aethertekUI/src/AethertekUI/AethertekUI.csproj" />
    <ProjectReference Include="../../aethertekUI/src/AethertekUI.Dalamud/AethertekUI.Dalamud.csproj" />
    <InternalsVisibleTo Include="MOGTOME.Tests" />
    <Compile Remove="backups\**" />
    <None Remove="backups\**" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <None Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="images\icon.png" />
    <None Include="data\autoduty-paths\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="data\bm\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyPluginArtifacts" AfterTargets="Build">

    <PropertyGroup>

      <PluginOutput>$(OutputPath)$(AssemblyName)</PluginOutput>

    </PropertyGroup>

    <MakeDir Directories="$(PluginOutput)" />

    <ItemGroup>
      <PluginFiles Include="$(TargetPath)" />
      <PluginFiles Include="$(TargetDir)AethertekUI.dll" />
      <PluginFiles Include="$(TargetDir)AethertekUI.Dalamud.dll" />
      <PluginFiles Include="$(ProjectDir)$(AssemblyName).json" />
      <PluginFiles Include="images\icon.png" />
      <PluginDataFiles Include="data\autoduty-paths\**" />
      <PluginBossModDataFiles Include="data\bm\**" />
      <PluginSatelliteFiles Include="$(TargetDir)fr\$(AssemblyName).resources.dll"><Culture>fr</Culture></PluginSatelliteFiles>
      <PluginSatelliteFiles Include="$(TargetDir)de\$(AssemblyName).resources.dll"><Culture>de</Culture></PluginSatelliteFiles>
      <PluginSatelliteFiles Include="$(TargetDir)ja\$(AssemblyName).resources.dll"><Culture>ja</Culture></PluginSatelliteFiles>
      <PluginSatelliteFiles Include="$(TargetDir)es\$(AssemblyName).resources.dll"><Culture>es</Culture></PluginSatelliteFiles>
      <PluginSatelliteFiles Include="$(TargetDir)it\$(AssemblyName).resources.dll"><Culture>it</Culture></PluginSatelliteFiles>
      <PluginSatelliteFiles Include="$(TargetDir)ru\$(AssemblyName).resources.dll"><Culture>ru</Culture></PluginSatelliteFiles>
      <PluginSatelliteFiles Include="$(TargetDir)ko\$(AssemblyName).resources.dll"><Culture>ko</Culture></PluginSatelliteFiles>
      <PluginSatelliteFiles Include="$(TargetDir)zh-Hans\$(AssemblyName).resources.dll"><Culture>zh-Hans</Culture></PluginSatelliteFiles>
      <PluginSatelliteFiles Include="$(TargetDir)vi\$(AssemblyName).resources.dll"><Culture>vi</Culture></PluginSatelliteFiles>
      <PluginSatelliteFiles Include="$(TargetDir)pt-BR\$(AssemblyName).resources.dll"><Culture>pt-BR</Culture></PluginSatelliteFiles>
      <PluginSatelliteFiles Include="$(TargetDir)id\$(AssemblyName).resources.dll"><Culture>id</Culture></PluginSatelliteFiles>
      <PluginSatelliteFiles Include="$(TargetDir)pl\$(AssemblyName).resources.dll"><Culture>pl</Culture></PluginSatelliteFiles>
      <PluginSatelliteFiles Include="$(TargetDir)tr\$(AssemblyName).resources.dll"><Culture>tr</Culture></PluginSatelliteFiles>
      <PluginSatelliteFiles Include="$(TargetDir)hi\$(AssemblyName).resources.dll"><Culture>hi</Culture></PluginSatelliteFiles>
    </ItemGroup>

    
    <Copy SourceFiles="@(PluginFiles)"

          DestinationFolder="$(PluginOutput)" />

    <Copy SourceFiles="@(PluginDataFiles)"
          DestinationFiles="@(PluginDataFiles->'$(PluginOutput)\data\autoduty-paths\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <Copy SourceFiles="@(PluginBossModDataFiles)"
          DestinationFiles="@(PluginBossModDataFiles->'$(PluginOutput)\data\bm\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <Copy SourceFiles="@(PluginSatelliteFiles)"
          DestinationFiles="@(PluginSatelliteFiles->'$(PluginOutput)\%(Culture)\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

  </Target>

</Project>
